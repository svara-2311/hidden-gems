OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Local Postgres: set DATABASE_URL and leave DIRECT_URL the same (or unset).
# Supabase: use the "Connect → ORMs (Prisma)" values — DATABASE_URL is the
# transaction pooler (:6543 ?pgbouncer=true), DIRECT_URL is the session pooler
# (:5432) used for migrations.
DATABASE_URL=postgresql://user:password@localhost:5432/hidden_gems
DIRECT_URL=postgresql://user:password@localhost:5432/hidden_gems
